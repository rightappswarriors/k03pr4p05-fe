{
  "expo": {
    "name": "POS Vine",
    "slug": "pos-vine",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "AUTH_TOKEN_KEY": "auth_token",
      "USER_DATA_KEY": "user_data",
      "BIOMETRIC_ENABLED_KEY": "biometric_enable",
      "REFRESH_TOKEN_KEY": "refreshToken",
      "router": {},
      "eas": {
        "projectId": "94c779c4-51cb-49b6-a9c5-5ae7fa3ec0b3"
      }
    },
    "android": {
      "package": "com.rusiana.raipos"
    },
    "owner": "rusiana"
  }
}
