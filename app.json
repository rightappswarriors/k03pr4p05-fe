{
  "expo": {
    "name": "POS Vine-2",
    "slug": "pos-vine-mman",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "This app uses Bluetooth to connect to printers."
      }
    },
    "android": {
      "package": "com.rusiana.raipos",
      "permissions": [
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_SCAN",
        "ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "process.env.EXPO_PUBLIC_GOOGLE_MAPS_API_KEY"
        }
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "./app.plugin.js",
      "expo-web-browser",
      "expo-secure-store",
      [
        "react-native-permissions",
        {
          "iosPermissions": ["BluetoothPeripheral", "Bluetooth"],
          "androidPermissions": [
            "android.permission.BLUETOOTH_CONNECT",
            "android.permission.BLUETOOTH_SCAN",
            "android.permission.ACCESS_FINE_LOCATION"
          ]
        }
      ],
      "expo-build-properties",
      "expo-audio",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "AUTH_TOKEN_KEY": "auth_token",
      "USER_DATA_KEY": "user_data",
      "BIOMETRIC_ENABLED_KEY": "biometric_enable",
      "REFRESH_TOKEN_KEY": "refreshToken",
      "API_BASE_URL": "http://localhost:4000",
      "router": {},
      "eas": {
        "projectId": "de692183-0733-4faa-812c-e994f6995fe1"
      }
    },
    "owner": "nuelgrace"
  }
}
