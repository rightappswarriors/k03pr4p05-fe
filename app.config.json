{
     "expo": {
       "name": "POS Vine",
       "slug": "pos-vine",
       "version": "1.0.3",
       "orientation": "portrait",
       "icon": "./assets/images/icon.png",
       "scheme": "myapp",
       "userInterfaceStyle": "automatic",
       "newArchEnabled": true,
       "ios": {
         "supportsTablet": true,
         "infoPlist": {
           "NSBluetoothAlwaysUsageDescription": "This app uses Bluetooth to connect to printers."
         }
       },
       "android": {
         "package": "com.rusiana.raipos",
         "permissions": [
           "BLUETOOTH",
           "BLUETOOTH_ADMIN",
           "BLUETOOTH_CONNECT",
           "BLUETOOTH_SCAN",
           "ACCESS_FINE_LOCATION"
         ]
       },
       "web": {
         "bundler": "metro",
         "output": "single",
         "favicon": "./assets/images/favicon.png"
       },
       "plugins": [
         "expo-router",
         "expo-font",
         "./app.plugin.js",
         "expo-web-browser",
         "expo-secure-store",
         [
           "react-native-permissions",
           {
             "iosPermissions": ["BluetoothPeripheral", "Bluetooth"],
             "androidPermissions": [
               "android.permission.BLUETOOTH_CONNECT",
               "android.permission.BLUETOOTH_SCAN",
               "android.permission.ACCESS_FINE_LOCATION"
             ]
           }
         ],
         [
           "react-native-ble-plx",
           {
             "isBackgroundEnabled": true,
             "modes": ["central"],
             "bluetoothAlwaysPermission": "Allow $(PRODUCT_NAME) to connect to Bluetooth devices"
           }
         ]
       ],
       "experiments": {
         "typedRoutes": true
       },
       "extra": {
         "AUTH_TOKEN_KEY": "auth_token",
         "USER_DATA_KEY": "user_data",
         "BIOMETRIC_ENABLED_KEY": "biometric_enable",
         "REFRESH_TOKEN_KEY": "refreshToken",
         "API_BASE_URL": "http://10.0.2.2:4000", 
         "router": {},
         "eas": {
           "projectId": "94c779c4-51cb-49b6-a9c5-5ae7fa3ec0b3"
         }
       },
   
       "owner": "rusiana"
     }
   }
   